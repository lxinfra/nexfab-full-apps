[TEMPLATE]
# NexoFab website + admin server
PORT=3000
ADMIN_USERNAME=NEXOADMIN
ADMIN_PASSWORD=Anandmdlx1%

# Public URLs of the three internal apps.
# Deploy each app first, then paste its address here (e.g. https://bills.example.com).
# Leave blank to show "Not configured" in the admin panel.
SALARY_SLIP_URL=
BILL_GENERATOR_URL=
TEMPLATE_BUILDER_URL=

# ---------------------------------------------------------------------------
# ONE-SERVICE APP STACK (Docker on Render)
# Every value below is an environment variable of the single Render service
# (see render.yaml). The same file works locally:
#   docker build -t nexofab-apps .
#   docker run --env-file .env -p 8080:8080 nexofab-apps
# Names are namespaced per app because all three would collide on DATABASE_URL.
# ---------------------------------------------------------------------------

# ---- Salary Slip (its own Supabase project; tables live in the `salary` schema)
# Supabase > Project Settings > Database. URL-encode special password characters (@ becomes %40).
SALARY_DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=salary
SALARY_DIRECT_URL=postgresql://postgres.YOUR-REF:PASSWORD@db.YOUR-REF.supabase.com:5432/postgres?schema=salary

# ---- Bill Generator (its own Supabase project)
# Values provided by user — keep these exact or override via Render env vars.
BILL_DATABASE_URL=postgresql://postgres.iedksxxkupqesxixbvxh:Karbeer%402181@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
BILL_DIRECT_URL=postgresql://postgres.iedksxxkupqesxixbvxh:Karbeer%402181@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://iedksxxkupqesxixbvxh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImllZGtzeHhrdXBxZXN4aXhidnhoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA5NDkyNDUsImV4cCI6MjEwNjUyNTI0NX0.uCOFQ9rMmTYWQ2IPHzIoymy4wCOV-xMemFsPNoeLPsI
