# Copy to backend/.env and fill in. Without DATABASE_URL the app uses SQLite in /data;
# without the SUPABASE_ values it keeps files in /storage.

# Supabase > Project Settings > Database > Connection string (session pooler).
# URL-encode special characters in the password (@ becomes %40).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API. Use the service_role key: it stays on the server.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=templates

# Sites allowed to call the API, comma separated (the address of the hosted frontend).
CORS_ORIGINS=http://localhost:3000

# Sign-in is on whenever the SUPABASE_ values are set (accounts live in Supabase Auth).
# Who may create an account on the sign-in screen:
#   first  = only while there is no account yet (the owner's), then nobody
#   always = anyone who can open the site
#   never  = nobody; add people in Supabase > Authentication > Users
ALLOW_SIGNUP=first
# AUTH=none      # run without sign-in (only for a private computer)
