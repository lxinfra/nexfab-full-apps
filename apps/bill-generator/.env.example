# ---------------------------------------------------------------------------
# Database
#
# Local default (works out of the box, no account needed):
DATABASE_URL="file:./dev.db"
#
# Supabase Postgres — take this from
#   Supabase dashboard > Project Settings > Database > Connection string > URI
# Use the POOLER (port 6543) string for the app, and set DIRECT_URL to the
# direct (port 5432) string so Prisma migrations work.
# Then change the datasource provider in prisma/schema.prisma to "postgresql".
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase (file storage, and the SQL/RPC in supabase/migrations)
#
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server only. NEVER prefix this with NEXT_PUBLIC_ and never commit it —
# it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=""

# Created by supabase/migrations/0002_storage_and_rls.sql
SUPABASE_STORAGE_BUCKET="bill-files"
