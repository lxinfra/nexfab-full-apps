# Salary Slip Maker — Supabase Postgres (schema: salary)
#
# Supabase dashboard > your project > Connect > Database > Connection string > URI.
# DATABASE_URL uses the POOLER in SESSION mode (port 5432 on the pooler host).
# Do NOT use transaction mode (port 6543) — Prisma's prepared statements fail there
# with `prepared statement "..." does not exist`.
# DIRECT_URL uses the direct connection (port 5432) so Prisma schema pushes work.
# The ?schema=salary suffix isolates this app's tables from other apps sharing
# the same Supabase project (e.g. the Bill Generator's `public` schema tables).
# URL-encode special characters in the password (@ becomes %40, % becomes %25).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=salary"
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?schema=salary"
